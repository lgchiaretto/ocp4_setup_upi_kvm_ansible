# =============================================================================
# OpenShift UPI KVM Automation - Git Ignore
# =============================================================================

# -----------------------------------------------------------------------------
# IDE and Editor Files
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.*.sw?
.github/
.lock

# -----------------------------------------------------------------------------
# Ansible Runtime Files
# -----------------------------------------------------------------------------
*.retry
.ansible/
ansible.log
*.log

# -----------------------------------------------------------------------------
# Python Cache and Virtual Environments
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
ENV/
env/
.venv/

# -----------------------------------------------------------------------------
# Secrets and Sensitive Data
# -----------------------------------------------------------------------------
# Pull secrets (NEVER commit these!)
pull-secret.txt
pull-secret.json
*-pull-secret*

# SSH keys (if accidentally placed here)
*.pem
id_rsa*
id_ed25519*
id_ecdsa*

# Ansible vault password files
.vault_pass
.vault_password
vault-password*

# HTPasswd files
htpasswd
*.htpasswd

# Kubeconfig files
kubeconfig
kubeconfig-*

# -----------------------------------------------------------------------------
# Cluster Artifacts (Generated by Automation)
# -----------------------------------------------------------------------------
# Ignition configs (contain sensitive data)
*.ign

# QCOW2 disk images
*.qcow2

# ISO files
*.iso

# OpenShift install state files
.openshift_install.log
.openshift_install_state.json
terraform.*
metadata.json

# Auth directory contents (kubeconfig, kubeadmin-password)
auth/

# -----------------------------------------------------------------------------
# Testing and Coverage
# -----------------------------------------------------------------------------
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
nosetests.xml
coverage.xml
*.cover

# -----------------------------------------------------------------------------
# OS Generated Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Temporary Files
# -----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
tmp/
temp/

# -----------------------------------------------------------------------------
# Custom User Configurations
# -----------------------------------------------------------------------------
# Allow ansible-vars-kvm.yaml to be committed as example
# but ignore user-specific variants
ansible-vars-*.yaml
!ansible-vars-kvm.yaml

# Local inventory files
inventory.local
hosts.local
