<network>
  <name>{{ ocp_network_name }}</name>
  <forward mode='nat'/>
  <bridge name='virbr-{{ clustername[:8] }}' stp='on' delay='0'/>
  <domain name='{{ clustername }}.{{ basedomain }}' localOnly='yes'/>
  <dns enable='yes'>
    <!-- Single master node -->
    <host ip='{{ master0ip.stdout_lines | first }}'>
      <hostname>{{ clustername }}-master-0.{{ basedomain }}</hostname>
      <hostname>{{ clustername }}-master-0.{{ clustername }}.{{ basedomain }}</hostname>
      <hostname>etcd-0.{{ clustername }}.{{ basedomain }}</hostname>
      <hostname>api.{{ clustername }}.{{ basedomain }}</hostname>
      <hostname>api-int.{{ clustername }}.{{ basedomain }}</hostname>
    </host>
    <!-- SRV record for etcd -->
    <srv service='etcd-server-ssl' protocol='tcp' domain='{{ clustername }}.{{ basedomain }}' target='etcd-0.{{ clustername }}.{{ basedomain }}' port='2380' priority='0' weight='10'/>
  </dns>
  <dnsmasq:options xmlns:dnsmasq='http://libvirt.org/schemas/network/dnsmasq/1.0'>
    <dnsmasq:option value='address=/apps.{{ clustername }}.{{ basedomain }}/{{ master0ip.stdout_lines | first }}'/>
  </dnsmasq:options>
  <ip address='{{ cluster_network_base }}.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='{{ cluster_network_base }}.100' end='{{ cluster_network_base }}.250'/>
      <!-- DHCP reservation for master -->
      <host mac='{{ master0infosno.stdout }}' ip='{{ master0ip.stdout_lines | first }}'/>
    </dhcp>
  </ip>
</network>
